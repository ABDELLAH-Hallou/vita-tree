include README.md LICENSE THIRD_PARTY_NOTICES.md CHANGELOG.md SECURITY.md pyproject.toml
include package.json package-lock.json
recursive-include scripts *.mjs *.py *.ps1 *.sh
recursive-include tests *.py
recursive-exclude * __pycache__ *.py[cod]
prune .test-artifacts
prune .venv
prune node_modules
